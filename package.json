{
  "name": "numberdroid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "materialize-art": "node scripts/materialize-art-assets.mjs",
    "render-walls": "node scripts/render-transfer-hall-walls.mjs",
    "validate-art-seams": "node scripts/validate-wall-seams.mjs",
    "predev": "npm run materialize-art && npm run render-walls",
    "dev": "vite",
    "test": "vitest run",
    "prebuild": "npm run materialize-art && npm run render-walls && npm run validate-art-seams",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "typescript": "^5.8.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2"
  }
}
