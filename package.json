{
  "name": "numberdroid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "materialize-art": "node scripts/materialize-art-assets.mjs && node scripts/sanitize-materialized-actor-assets.mjs",
    "materialize-transfer-apparatus": "node scripts/materialize-transfer-apparatus.mjs",
    "materialize-yellow-core": "node scripts/materialize-yellow-core.mjs",
    "materialize-flow-regulator": "node scripts/materialize-flow-regulator.mjs",
    "materialize-family-floor": "node scripts/materialize-family-floor.mjs",
    "generate:character-grounding": "node scripts/generate-character-grounding-css.mjs",
    "diagnose:pico-grounding": "node scripts/diagnose-pico-grounding.mjs",
    "preview:pico-grounding": "node scripts/render-pico-grounding-runtime-preview.mjs",
    "actor:source-integrity": "node scripts/assert-directional-actor-source-integrity.mjs",
    "render-walls": "node scripts/render-transfer-hall-walls.mjs",
    "render-doors": "node scripts/render-transfer-hall-door-art.mjs",
    "validate-art-seams": "node scripts/validate-wall-seams.mjs",
    "art:toolkit-test": "node scripts/art/toolkit/selftest.mjs && npm run actor:source-integrity",
    "repo:binary-preflight": "node scripts/repo/binary-transport-preflight.mjs",
    "repo:binary-preflight-test": "node scripts/repo/binary-transport-preflight.selftest.mjs",
    "repo:approved-source-handoff": "node scripts/repo/approved-source-upload-handoff.mjs",
    "repo:approved-source-handoff-test": "node scripts/repo/approved-source-upload-handoff.selftest.mjs",
    "predev": "npm run generate:character-grounding && npm run materialize-art && npm run materialize-transfer-apparatus && npm run materialize-yellow-core && npm run materialize-flow-regulator && npm run materialize-family-floor && npm run render-walls && npm run render-doors",
    "dev": "vite",
    "test": "vitest run",
    "prebuild": "npm run generate:character-grounding && npm run materialize-art && npm run materialize-transfer-apparatus && npm run materialize-yellow-core && npm run materialize-flow-regulator && npm run materialize-family-floor && npm run render-walls && npm run render-doors && npm run validate-art-seams",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "typescript": "^5.8.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2"
  }
}
