{
  "name": "@numberdroid/studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, agent-first visual authoring foundation for Numberdroid rooms and levels.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run check",
    "check": "node scripts/check-javascript-syntax.js",
    "check:selftest": "node scripts/check-javascript-syntax.selftest.js",
    "dev": "node apps/studio-server/src/server.js",
    "demo:seed": "node apps/studio-server/src/seed-demo.js",
    "evidence:verify": "node scripts/checkpoint-1a-evidence.js",
    "evidence:visual-prepare": "node scripts/prepare-visual-evidence.js",
    "mcp": "node apps/studio-mcp/src/main.js",
    "admin": "node apps/studio-admin/src/main.js",
    "remote:start": "node apps/studio-remote/src/main.js",
    "remote:check": "node apps/studio-remote/src/check-config.js",
    "remote:credential": "node apps/studio-remote/src/create-credential.js",
    "remote:mark-mount": "node apps/studio-remote/src/create-mount-marker.js",
    "test": "node --test tests/*.node-test.js",
    "test:watch": "node --test --watch tests/*.node-test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "13.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "exports": {
    ".": "./packages/application/src/index.js",
    "./domain": "./packages/domain/src/index.js",
    "./application": "./packages/application/src/index.js",
    "./persistence": "./packages/persistence/src/index.js",
    "./preview": "./packages/preview/src/index.js",
    "./numberdroid-adapter": "./packages/numberdroid-adapter/src/index.js",
    "./mcp-server": "./packages/mcp-server/src/index.js",
    "./http-server": "./apps/studio-server/src/server.js"
  }
}
